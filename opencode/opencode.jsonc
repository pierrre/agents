{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "Codix-Iliad": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Codix Iliad",
      "settings": {
        "baseURL": "https://iliad.codix.scw.eu/v1",
        "apiKey": "{env:CODIX_TOKEN}"
      },
      "models": {
        "codiX-agent": {
          "name": "codiX agent",
          "limit": {
            "context": 250000,
            "output": 16384
          },
          "cost": {
            "input": 0.60,
            "output": 3.60
          }
        },
        "Zai/GLM-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "cost": {
            "input": 1.80,
            "output": 5.50
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "Deepseek/deepseek-v4-flash-0731": {
          "name": "deepseek-v4-flash-0731",
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "cost": {
            "input": 0.40,
            "output": 0.80,
            "cache": {
              "read": 0.08
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "Scaleway": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Scaleway",
      "settings": {
        "baseURL": "https://api.scaleway.ai/09d301e8-0c74-42b0-8e72-124c5d50f09b/v1",
        "apiKey": "{env:SCW_SECRET_KEY_PRODUCTION}"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "cost": {
            "input": 1.80,
            "output": 5.50
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "deepseek-v4-flash-0731": {
          "name": "deepseek-v4-flash-0731",
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "cost": {
            "input": 0.40,
            "output": 0.80,
            "cache": {
              "read": 0.08
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "cost": {
            "input": 0.60,
            "output": 3.30,
            "cache": {
              "read": 0.12
            }
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    }
  },
  "default_agent": "plan",
  "experimental": {
    "subagent_depth": 10
  },
  "enabled_providers": [
    "Codix-Iliad",
    "Scaleway"
  ],
  "snapshots": false,
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Git/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/lib/go/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/go/pkg/mod/*", "effect": "allow" }
  ],
  "formatter": {
    "gofmt": { "disabled": true },
    "goimports": {
      "command": ["go", "run", "golang.org/x/tools/cmd/goimports@latest", "-w", "$FILE"],
      "extensions": [".go"]
    }
  }
}
