{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Codix-Iliad": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Codix Iliad",
      "options": {
        "baseURL": "https://iliad.codix.scw.eu/v1",
        "apiKey": "{env:CODIX_TOKEN}"
      },
      "models": {
        "codiX-agent": {
          "name": "codiX agent",
          "limit": {
            "context": 250000,
            "output": 16000
          },
          "cost": {
            "input": 0.60,
            "output": 3.60
          },
        },
        "Zai/GLM-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 256000,
            "output": 16000
          },
          "cost": {
            "input": 1.80,
            "output": 5.50
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          }
        }
      }
    },
    "Scaleway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Scaleway",
      "options": {
        "baseURL": "https://api.scaleway.ai/09d301e8-0c74-42b0-8e72-124c5d50f09b/v1",
        "apiKey": "{env:SCW_SECRET_KEY_PRODUCTION}"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 256000,
            "output": 16000
          },
          "cost": {
            "input": 1.80,
            "output": 5.50
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max" }
          }
        }
      }
    }
  },
  "default_agent": "plan",
  //"model": "Codix-Iliad/codiX-agent",
  "enabled_providers": [
    "Codix-Iliad",
    "Scaleway"
  ],
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/Git/**": "allow",
      "~/go/pkg/mod/**": "allow",
      "/home/pierre/.agents/**": "allow",
      "/usr/lib/go/**": "allow",
      "/tmp/opencode/**": "allow",
      "/tmp/**": "allow"
    },
  },
  "lsp": {
    "gopls": {
      "command": [
        "gopls",
        "-remote=auto",
      ]
    }
  },
  "formatter": {
    "gofmt": { "disabled": true },
    "goimports": {
      "command": ["go", "run", "golang.org/x/tools/cmd/goimports@latest", "-w", "$FILE"],
      "extensions": [".go"]
    }
  }
}
